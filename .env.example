# ==============================================================================
# Mini Project 2026: Wireless Network Traffic Monitor Using Zeek
# Environment Configuration Template
# ==============================================================================

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zeek_monitor
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=5

# Processing & Queue Configuration (OS / Concurrency)
BUFFER_CAPACITY=256
NUM_CONSUMER_WORKERS=4
QUEUE_TIMEOUT_SECONDS=1.0

# Detection Engine Thresholds (Rule-Based & ML)
FAILED_CONN_THRESHOLD=10
TIME_WINDOW_SECONDS=60
PORT_SCAN_PORT_COUNT_THRESHOLD=15

# Webhook Alerting Configuration
WEBHOOK_ENABLED=true
WEBHOOK_URL=http://127.0.0.1:5000/api/v1/alerts/webhook/test

# Flask Backend
FLASK_ENV=development
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
