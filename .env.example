# =============================================================
# NetSentinel — Environment Variables Example
# Copy to .env and fill in values. DO NOT commit .env to git.
# =============================================================

# Application
APP_NAME=NetSentinel
APP_ENV=development
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://netsentinel:netsentinel_dev@localhost:5432/netsentinel
DATABASE_SYNC_URL=postgresql://netsentinel:netsentinel_dev@localhost:5432/netsentinel

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Synthetic event generator
SYNTHETIC_ENABLED=true
SYNTHETIC_EVENTS_PER_SECOND=2.0
SYNTHETIC_ANOMALY_RATE=0.05

# Detection engine
DETECTION_ENABLED=true
DETECTION_WINDOW_SECONDS=60
DNS_QUERY_RATE_THRESHOLD=50
PORT_SCAN_PORT_THRESHOLD=20
AUTH_FAILURE_THRESHOLD=5
BANDWIDTH_ANOMALY_FACTOR=3.0

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Logging
LOG_LEVEL=INFO
